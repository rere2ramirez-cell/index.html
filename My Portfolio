<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Renier | My Portfolio</title>
    <link rel="stylesheet" href="style.css">
  <style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    background: #080b16;
    color: white;
    font-family: Arial, sans-serif;
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 25px 8%;
    background: #101629;
    position: sticky;
    top: 0;
    z-index: 100;
}

.logo {
    color: white;
    font-size: 28px;
}

span {
    color: #00eaff;
}

nav a {
    color: white;
    text-decoration: none;
    margin-left: 20px;
    transition: .3s;
}

nav a:hover {
    color: #00eaff;
}

.hero {
    min-height: 90vh;
    padding: 70px 8%;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: center;
    gap: 40px;
}

.welcome {
    color: #00eaff;
    letter-spacing: 4px;
}

.hero h1 {
    font-size: clamp(40px, 6vw, 70px);
    margin: 20px 0;
}

.hero h2 {
    color: #00eaff;
    margin-bottom: 20px;
}

.hero-text p {
    line-height: 1.8;
}

.hero-img {
    text-align: center;
}

.hero-img img {
    width: min(100%, 350px);
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    border: 5px solid #00eaff;
    box-shadow: 0 0 35px #00eaff;
}

.btn, button {
    display: inline-block;
    margin-top: 25px;
    padding: 14px 28px;
    background: #00eaff;
    color: #080b16;
    font-weight: bold;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    text-decoration: none;
    transition: .3s;
}

.btn:hover, button:hover {
    background: white;
    box-shadow: 0 0 20px #00eaff;
}

.section {
    padding: 90px 8%;
    text-align: center;
}

.section h2 {
    font-size: 35px;
    margin-bottom: 30px;
}

.section p {
    line-height: 1.8;
}

.cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.card {
    background: #121b31;
    padding: 35px 20px;
    border: 1px solid #00eaff;
    border-radius: 15px;
    transition: .3s;
}

.card:hover {
    transform: translateY(-10px);
    box-shadow: 0 0 20px #00eaff;
}

form {
    max-width: 600px;
    margin: auto;
    display: grid;
    gap: 18px;
}

input, textarea {
    padding: 16px;
    background: #121b31;
    color: white;
    border: 1px solid #00eaff;
    border-radius: 8px;
    font-size: 16px;
    width: 100%;
}

textarea {
    height: 150px;
    resize: vertical;
}

footer {
    text-align: center;
    padding: 25px;
    background: #101629;
}

/* MOBILE RESPONSIVE */
@media (max-width: 768px) {

    header {
        flex-direction: column;
        gap: 20px;
    }

    nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
    }

    nav a {
        margin: 0;
        font-size: 13px;
    }

    .hero {
        grid-template-columns: 1fr;
        text-align: center;
    }

    .hero-img {
        grid-row: 1;
    }

    .cards {
        grid-template-columns: 1fr;
    }
}
</style>
</head>
<body>

<header>
    <h2 class="logo"> My <span>Portfolio</span></h2>
    <nav>
        <a href="#home">Home</a>
        <a href="#about">About</a>
        <a href="#skills">Skills</a>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
    </nav>
</header>

<section id="home" class="hero">
    <div class="hero-text">
        <h1><p class="welcome"> HE I'M</p>
        <h1> <span>Renier M.Ramirez</span></h1>
        <h2>BSIT Student | Future Web Developer</h2>
        <p>
            I create modern, creative and responsive
            websites using HTML, CSS and JavaScript.
        </p>
        <a href="#contact" class="btn">CONTACT ME</a>
    </div>

    <div class="ramirez.jpg">
        <img src="profile.jpg" alt="Renier Profile">
    </div>
</section>

<section id="about" class="section">
    <h2>ABOUT <span>ME</span></h2>
    <p>
        My name is Renier Montaño Ramirez.
        I am a BSIT student who loves technology,
        web development, and learning new skills.
        My goal is to become a professional developer.
    </p>
</section>

<section id="skills" class="section">
    <h2>MY <span>SKILLS</span></h2>
    <div class="cards">
        <div class="card">HTML</div>
        <div class="card">CSS</div>
        <div class="card">JavaScript</div>
        <div class="card">Responsive Design</div>
    </div>
</section>

<section id="projects" class="section">
    <h2>MY <span>PROJECTS</span></h2>
    <div class="cards">
        <div class="card">
            <h3>Personal Portfolio</h3>
            <p>My personal website design.</p>
        </div>
        <div class="card">
            <h3>Registration Form</h3>
            <p>A student registration website.</p>
        </div>
        <div class="card">
            <h3>HTML Projects</h3>
            <p>My practice web development projects.</p>
        </div>
    </div>
</section>

<section id="contact" class="section">
    <h2>CONTACT <span>ME</span></h2>

    <form action="https://formsubmit.co/ramirezre@gmail.com"
          method="POST">

        <input type="text" name="name"
               placeholder="Your Name" required>

        <input type="email" name="email"
               placeholder="Your Email" required>

        <textarea name="message"
                  placeholder="Your Message"
                  required></textarea>

        <input type="hidden" name="_subject"
               value="New Portfolio Message!">

        <input type="hidden" name="_captcha"
               value="true">

        <button type="submit">SEND MESSAGE</button>
    </form>
</section>

<footer>
    <p>© 2026 Renier Montaño Ramirez | All Rights Reserved.</p>
</footer>

<script src="script.js"></script>
</body>
</html>
